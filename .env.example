# Copy to .env (start.ps1 / start.sh do this for you). Everything is optional.

# PayPal sandbox. Leave empty to use the built-in mock (no account needed).
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Public URL of this gateway (PayPal return links and MCP snippets use it).
ERRAND_BASE_URL=http://localhost:8000

# 1 = demo mode: seeds Alan + four simulated Runners and enables one-click demo logins.
ERRAND_DEMO=1

# Platform take rate and how often mystery errands audit Runners.
ERRAND_TAKE_RATE=0.10
ERRAND_MYSTERY_RATE=0.25

# Simulated Runner latency (1.0 = realistic, 0 = instant).
ERRAND_SIM_LATENCY_SCALE=1.0

# Where the SQLite database lives.
# ERRAND_DB=.errand/errand.db
