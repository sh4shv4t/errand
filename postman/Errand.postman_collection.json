              "path": [
                "v1",
                "errands"
              ]
            },
            "description": "Every errand with its verdict, Runner, cost and savings."
          }
        },
        {
          "name": "Top up with PayPal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/wallet/topup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "wallet",
                "topup"
              ]
            },
            "description": "Returns a PayPal approval link (Orders v2, CAPTURE). A human opens it and approves; the wallet is credited on return.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_usd\": 5,\n  \"purpose\": \"wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Post a PayPal bounty",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/bounties",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "bounties"
              ]
            },
            "description": "PayPal Orders v2 with intent AUTHORIZE: captured only if the answer verifies, voided otherwise.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"What is 12% of 2450?\",\n  \"check\": \"294\",\n  \"amount_usd\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
