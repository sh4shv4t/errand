{
  "info": {
    "name": "Errand API",
    "description": "Send your model on fewer errands. Delegate sub-tasks to cheaper specialist models and pay through PayPal only when the answer checks out.\n\nSet `base_url` and `api_key` (a Sender key; `errand keys` prints the demo ones), then start with the Quickstart folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "api_key",
      "value": "erk_YOUR_SENDER_KEY"
    }
  ],
  "item": [
    {
      "name": "Quickstart",
      "item": [
        {
          "name": "Delegate a math job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/delegate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "delegate"
              ]
            },
            "description": "One call. Errand picks the Lane and the specialist, checks the answer against `check`, and only then pays.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"A train travels 216 km in 12 hours at a constant speed. What is its speed in km per hour?\",\n  \"check\": \"18\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delegate a code job (with tests)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/delegate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "delegate"
              ]
            },
            "description": "Code needs tests in `check`. Payment is released only if they pass; failed attempts are retried elsewhere for free.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Write a Python function is_palindrome(s) that ignores case and spaces.\",\n  \"check\": \"assert is_palindrome('racecar')\\nassert is_palindrome('Never odd or even')\\nassert not is_palindrome('hello')\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delegate to a Runner you pick",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/delegate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "delegate"
              ]
            },
            "description": "Pin a Runner by name or id. If it is unavailable or over budget, Errand falls back to the next best one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"What is 17 * 23?\",\n  \"check\": \"391\",\n  \"runner\": \"Atlas\",\n  \"budget_usd\": 0.01\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List Runners you can pick",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/runners",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "runners"
              ]
            },
            "description": "Active specialists with their Lanes and prices."
          }
        },
        {
          "name": "Wallet, tier and savings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            },
            "description": "Balance, 30-day spend and how much you saved versus a frontier model."
          }
        },
        {
          "name": "Your errands",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/errands",
              "host": [
